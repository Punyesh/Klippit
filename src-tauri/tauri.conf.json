{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klippit",
  "version": "0.1.0",
  "identifier": "com.klippit.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Klippit",
        "width": 480,
        "height": 720,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"]
  }
}
