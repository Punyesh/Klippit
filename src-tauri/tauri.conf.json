{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klippit",
  "version": "0.1.0",
  "identifier": "com.klippit.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": {
      "../mpv-scripts/clip-trigger.lua": "mpv-scripts/clip-trigger.lua",
      "../vlc-scripts/klippit-extension.lua": "vlc-scripts/klippit-extension.lua"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
