{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klippit",
  "version": "0.1.0",
  "identifier": "com.klippit.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"]
  }
}
